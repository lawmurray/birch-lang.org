site_name: 'Birch'
site_description: 'A probabilistic object-oriented programming language for machine learning and statistics.'
theme:
  name: 'material'
  palette:
    primary: 'green'
    accent: 'green'
  feature:
    tabs: true
markdown_extensions:
  - admonition
  - mdx_math:
      enable_dollar_delimiter: true
extra_javascript:
  - 'https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.2/MathJax.js?config=TeX-MML-AM_CHTML'
extra:
  social:
    - type: 'github'
      link: 'https://github.com/lawmurray'
google_analytics:
  - 'UA-115470196-1'
  - 'auto'
pages:
  - 'Home': index.md
  - 'Getting Started':
    - 'Installing': getting-started/installing.md
    - 'Platform installation guides':
      - 'Installing on Ubuntu Linux': getting-started/ubuntu.md
      - 'Installing on macOS': getting-started/macos.md
      - 'Installing on Windows 10': getting-started/windows.md
    - 'Using Eclipse': getting-started/using-eclipse.md
  - 'Tutorial':
    - tutorial.md
    - 'Creating a project': tutorial/creating-a-project.md
    - 'Creating a model': tutorial/creating-a-model.md
    - 'Example #1: Bayesian linear regression': tutorial/bayesian-linear-regression.md
  - 'Documentation':
    - documentation.md
    - 'Language':
      - documentation/language.md
      - 'Comments': documentation/language/comments.md
      - 'Variables': documentation/language/variables.md
      - 'Types': documentation/language/types.md
      - 'Assignments': documentation/language/assignments.md
      - 'Control Flow': documentation/language/control_flow.md
      - 'Tuples': documentation/language/tuples.md
      - 'Sequences': documentation/language/sequences.md
      - 'Arrays': documentation/language/arrays.md
      - 'Optionals': documentation/language/optionals.md
      - 'Functions': documentation/language/functions.md
      - 'Lambdas': documentation/language/lambdas.md
      - 'Fibers': documentation/language/fibers.md
      - 'Programs': documentation/language/programs.md
      - 'Operators': documentation/language/operators.md
      - 'Classes': documentation/language/classes.md
      - 'Aliases': documentation/language/aliases.md
      - 'Casts': documentation/language/casts.md
      - 'Weak References': documentation/language/weak_references.md
      - 'Special Topics': documentation/language/special_topics.md
    - 'Driver':
      - documentation/driver.md
      - 'Meta file': documentation/driver/meta_file.md
      - 'Commands':
        - 'init': documentation/driver/commands/init.md
        - 'check': documentation/driver/commands/check.md
        - 'build': documentation/driver/commands/build.md
        - 'install': documentation/driver/commands/install.md
        - 'uninstall': documentation/driver/commands/uninstall.md
        - 'dist': documentation/driver/commands/dist.md
        - 'docs': documentation/driver/commands/docs.md
        - 'clean': documentation/driver/commands/clean.md
